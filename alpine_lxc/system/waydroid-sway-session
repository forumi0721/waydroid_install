#!/bin/bash

set -u

LXC_CONFIG=/var/lib/waydroid/lxc/waydroid/config
LXC_BASE_CONFIG=/usr/lib/waydroid/data/configs/config_base
WAYDROID_CFG=/var/lib/waydroid/waydroid.cfg
WAYDROID_PROP=/var/lib/waydroid/waydroid.prop
WAYDROID_BASE_PROP=/var/lib/waydroid/waydroid.prop
HARDWARE_MANAGER=/usr/lib/waydroid/tools/services/hardware_manager.py
RRO_SOURCE=/var/lib/waydroid/rro
RRO_TARGET=/var/lib/waydroid/overlay/system/product/overlay

XDG_RUNTIME_DIR=/run/user/$(id -u)
DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG_RUNTIME_DIR/bus
WAYLAND_DISPLAY=wayland-0

VNC_BIND=${VNC_BIND:-0.0.0.0}
VNC_PORT=${VNC_PORT:-5900}
VNC_FPS=${VNC_FPS:-15}
SWAY_CONFIG=$XDG_RUNTIME_DIR/sway-waydroid.conf

ADB_BIND=${ADB_BIND:-}
ADB_PORT=${ADB_PORT:-5555}
ANDROID_IP=${ANDROID_IP:-}

DBUS_PID=
PULSE_STARTED=0
SWAY_PID=
WAYVNC_PID=
SESSION_PID=
UI_PID=
SOCAT_PID=
SWAYSOCK=
CLEANING=0
CONTAINER_FAILURES=0
CONTAINER_FAILURE_LIMIT=${CONTAINER_FAILURE_LIMIT:-3}
RUN_UID=$(id -u)
RUN_GID=$(id -g)

export XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS WAYLAND_DISPLAY
export WLR_BACKENDS=headless
export WLR_HEADLESS_OUTPUTS=1
export WLR_LIBINPUT_NO_DEVICES=1
export WLR_RENDERER=pixman
export WLR_RENDERER_ALLOW_SOFTWARE=1

log()
{
    printf '%s\n' "[waydroid-sway] $*"
}

run_root()
{
    if [ "$RUN_UID" -eq 0 ]; then
        "$@"
    else
        sudo "$@"
    fi
}

is_running()
{
    [ -n "$1" ] && kill -0 "$1" 2>/dev/null
}

container_is_running()
{
    waydroid status 2>/dev/null |
        grep -q 'Container:[[:space:]]*RUNNING'
}

cleanup()
{
    [ "$CLEANING" -eq 0 ] || return 0
    CLEANING=1
    trap - EXIT INT TERM HUP

    log "stopping remote display and Waydroid session"

    is_running "$WAYVNC_PID" && kill "$WAYVNC_PID" 2>/dev/null
    is_running "$SOCAT_PID" && kill "$SOCAT_PID" 2>/dev/null
    is_running "$UI_PID" && kill "$UI_PID" 2>/dev/null

    waydroid session stop >/dev/null 2>&1 || true
    is_running "$SESSION_PID" && kill "$SESSION_PID" 2>/dev/null

    is_running "$SWAY_PID" && kill "$SWAY_PID" 2>/dev/null

    # This host is dedicated to this root Waydroid session.  Clean an instance
    # inherited from an earlier interrupted run as well as one started here.
    pulseaudio --kill >/dev/null 2>&1 || true
    pkill -x gsettings-helper 2>/dev/null || true
    is_running "$DBUS_PID" && kill "$DBUS_PID" 2>/dev/null
    pkill -f "^dbus-daemon --session --address=unix:path=$XDG_RUNTIME_DIR/bus " \
        2>/dev/null || true

    run_root waydroid container stop >/dev/null 2>&1 || true
    run_root /etc/init.d/waydroid-container stop >/dev/null 2>&1 || true
    run_root pkill -f '^supervise-daemon waydroid-container ' 2>/dev/null || true
    run_root pkill -f '^python3 /usr/bin/waydroid container start$' 2>/dev/null || true
    run_root pkill -f "^socat TCP-LISTEN:${ADB_PORT}," 2>/dev/null || true
    run_root pkill -f "^/usr/bin/socat TCP-LISTEN:${ADB_PORT}," 2>/dev/null || true
    run_root pkill -f "^adb -L tcp:" 2>/dev/null || true

    rm -f "$SWAY_CONFIG"
    rm -f "$XDG_RUNTIME_DIR/bus" "$XDG_RUNTIME_DIR/pulse/native" \
        2>/dev/null || true
    run_root rm -f /run/waydroid-container.pid 2>/dev/null || true

    wait 2>/dev/null || true
    log "stopped"
}

set_waydroid_property() {
    local key="$1"
    local value="$2"
    local cfg="${WAYDROID_CFG:-/var/lib/waydroid/waydroid.cfg}"
    local tmp mode owner group

    [ -f "$cfg" ] || {
        echo "ERROR: config not found: $cfg" >&2
        return 1
    }

    case "$key$value" in
        *'
'*)
            echo "ERROR: key/value must not contain newlines" >&2
            return 1
            ;;
    esac

    mode="$(stat -c '%a' "$cfg")"
    owner="$(stat -c '%u' "$cfg")"
    group="$(stat -c '%g' "$cfg")"
	tmp="$(mktemp "${TMPDIR:-/tmp}/waydroid.cfg.XXXXXX")" || return 2

    if ! CFG_KEY="$key" CFG_VALUE="$value" awk '
    BEGIN {
        key = ENVIRON["CFG_KEY"]
        value = ENVIRON["CFG_VALUE"]

        in_properties = 0
        properties_found = 0
        property_written = 0
    }

    /^[[:space:]]*\[properties\][[:space:]]*$/ {
        in_properties = 1
        properties_found = 1
        print
        next
    }

    /^[[:space:]]*\[[^]]+\][[:space:]]*$/ {
        if (in_properties && !property_written) {
            print key " = " value
            property_written = 1
        }

        in_properties = 0
    }

    in_properties && index($0, "=") {
        line = $0
        sub(/=.*/, "", line)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)

        if (line == key) {
            if (!property_written) {
                print key " = " value
                property_written = 1
            }
            next
        }
    }

    {
        print
    }

    END {
        if (in_properties && !property_written) {
            print key " = " value
        } else if (!properties_found) {
            print ""
            print "[properties]"
            print key " = " value
        }
    }
    ' "$cfg" > "$tmp"; then
        rm -f "$tmp"
        return 1
    fi

    if cmp -s "$cfg" "$tmp"; then
        rm -f "$tmp"
        echo "Property unchanged: $key = $value"
        return 1
    fi

    if ! run_root chown "$owner:$group" "$tmp" ||
       ! run_root chmod "$mode" "$tmp" ||
       ! run_root mv -f "$tmp" "$cfg"; then
        run_root rm -f "$tmp"
        echo "ERROR: failed to update: $cfg" >&2
        return 2
    fi

    echo "Property changed: $key = $value"
    return 0
}

trap cleanup EXIT
trap 'exit 0' INT TERM HUP

if [ "$RUN_UID" -ne 0 ] && ! command -v sudo >/dev/null 2>&1; then
    log "sudo is required when running as $(id -un)"
    exit 1
fi

for command_name in sway swaymsg wayvnc dbus-daemon pulseaudio python3 ip socat; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        log "missing command: $command_name"
        log "install packages: apk add sway wayvnc dbus pulseaudio python3 iproute2 socat"
        exit 1
    fi
done

log "stopping an earlier display/session instance"
pkill -x wayvnc 2>/dev/null || true
pkill -x sway 2>/dev/null || true
pkill -x weston 2>/dev/null || true
waydroid session stop >/dev/null 2>&1 || true
run_root /etc/init.d/waydroid-container stop >/dev/null 2>&1 || true
run_root rm -f /tmp/sway-waydroid.log /tmp/waydroid-session.log \
    /tmp/waydroid-ui.log /tmp/wayvnc.log /tmp/waydroid-socat.log \
    2>/dev/null || true
run_root pkill -f "^socat TCP-LISTEN:${ADB_PORT}," 2>/dev/null || true
run_root pkill -f "^/usr/bin/socat TCP-LISTEN:${ADB_PORT}," 2>/dev/null || true
run_root pkill -f "^adb -L tcp:" 2>/dev/null || true

log "updating Waydroid LXC config"
if [ -e "${LXC_CONFIG}" ]; then
	run_root sed -i 's/^lxc.hook.post-stop = \/dev\/null/# lxc.hook.post-stop = \/dev\/null/' ${LXC_CONFIG}
fi
if [ -e "${LXC_BASE_CONFIG}" ]; then
	run_root sed -i 's/^lxc.hook.post-stop = \/dev\/null/# lxc.hook.post-stop = \/dev\/null/' ${LXC_BASE_CONFIG}
fi

log "updating Waydroid configuration"
run_root sed -i 's/^auto_adb = .*/auto_adb = True/' "$WAYDROID_CFG"
run_root sed -i 's/^suspend_action = .*/suspend_action = none/' "$WAYDROID_CFG"

WAYDROID_CONFIG_CHANGED=0

if set_waydroid_property persist.waydroid.suspend false; then
    WAYDROID_CONFIG_CHANGED=1
fi

if set_waydroid_property ro.adb.secure 0; then
    WAYDROID_CONFIG_CHANGED=1
fi

if set_waydroid_property fw.max_users 5; then
    WAYDROID_CONFIG_CHANGED=1
fi

if set_waydroid_property fw.max_running_users 5; then
    WAYDROID_CONFIG_CHANGED=1
fi

if set_waydroid_property fw.show_multiuserui 1; then
    WAYDROID_CONFIG_CHANGED=1
fi

if [ "$WAYDROID_CONFIG_CHANGED" -eq 1 ]; then
    run_root waydroid upgrade -o
fi

