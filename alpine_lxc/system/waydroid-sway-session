if run_root test -d "$RRO_SOURCE"; then
    log "installing RRO APK files from $RRO_SOURCE"
    run_root find "$RRO_SOURCE" -maxdepth 1 -type f -name '*.apk' | while IFS= read -r apk; do
        overlay_name=${apk##*/}
        overlay_name=${overlay_name%.apk}
        destination=$RRO_TARGET/$overlay_name

        run_root mkdir -p "$destination"
        run_root cp -f "$apk" "$destination/$overlay_name.apk"
        run_root chmod 755 "$destination"
        run_root chmod 644 "$destination/$overlay_name.apk"
        run_root chown -R root:root "$destination"
        log "installed RRO: $overlay_name"
    done
fi

run_root install -d -o "$RUN_UID" -g "$RUN_GID" -m 700 "$XDG_RUNTIME_DIR"

# The previous compositor may leave socket pathnames behind after a forced stop.
rm -f "$XDG_RUNTIME_DIR"/wayland-* \
      "$XDG_RUNTIME_DIR"/sway-ipc.*.sock 2>/dev/null || true

if [ ! -S "$XDG_RUNTIME_DIR/bus" ]; then
    DBUS_PID=$(dbus-daemon \
        --session \
        --address="$DBUS_SESSION_BUS_ADDRESS" \
        --fork \
        --print-pid=1)
fi

if [ ! -S "$XDG_RUNTIME_DIR/bus" ]; then
    log "failed to start dbus"
    exit 1
fi

if [ ! -S "$XDG_RUNTIME_DIR/pulse/native" ]; then
    pulseaudio --daemonize=yes --exit-idle-time=-1
    PULSE_STARTED=1
fi

if [ ! -S "$XDG_RUNTIME_DIR/pulse/native" ]; then
    log "failed to start pulseaudio"
    exit 1
fi

cat >"$SWAY_CONFIG" <<'EOF'
output * mode 1280x720
output * bg #000000 solid_color

seat * hide_cursor 3000
focus_follows_mouse no
mouse_warping none

for_window [app_id="Waydroid"] fullscreen enable
for_window [app_id="waydroid"] fullscreen enable
for_window [title="Waydroid"] fullscreen enable
EOF

log "starting Sway headless compositor"
sway \
    --unsupported-gpu \
    --config "$SWAY_CONFIG" \
    > /tmp/sway-waydroid.log 2>&1 &
SWAY_PID=$!

attempt=0
while [ "$attempt" -lt 50 ]; do
    wayland_socket=$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -type s \
        -name 'wayland-*' 2>/dev/null | head -n 1)
    sway_socket=$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -type s \
        -name 'sway-ipc.*.sock' 2>/dev/null | head -n 1)

    if [ -n "$wayland_socket" ] && [ -n "$sway_socket" ]; then
        WAYLAND_DISPLAY=${wayland_socket##*/}
        SWAYSOCK=$sway_socket
        export WAYLAND_DISPLAY SWAYSOCK
        break
    fi

    if ! is_running "$SWAY_PID"; then
        log "Sway terminated during startup"
        tail -n 100 /tmp/sway-waydroid.log 2>/dev/null || true
        exit 1
    fi

    attempt=$((attempt + 1))
    sleep 0.1
done

if [ -z "$SWAYSOCK" ]; then
    log "Sway socket was not created"
    tail -n 100 /tmp/sway-waydroid.log 2>/dev/null || true
    exit 1
fi

output_name=$(swaymsg -s "$SWAYSOCK" -t get_outputs |
    sed -n 's/^Output \([^ ]*\).*/\1/p' |
    head -n 1)
output_name=${output_name:-HEADLESS-1}

swaymsg -s "$SWAYSOCK" output "$output_name" mode 1280x720 >/dev/null

log "starting Waydroid container"
run_root /etc/init.d/waydroid-container start

log "starting Waydroid session on $WAYLAND_DISPLAY"
waydroid session start > /tmp/waydroid-session.log 2>&1 &
SESSION_PID=$!

attempt=0
while [ "$attempt" -lt 60 ]; do
    if waydroid status 2>/dev/null | grep -q 'Session:[[:space:]]*RUNNING'; then
        break
    fi

    if ! is_running "$SESSION_PID"; then
        log "Waydroid session terminated during startup"
        tail -n 100 /tmp/waydroid-session.log 2>/dev/null || true
        exit 1
    fi

    attempt=$((attempt + 1))
    sleep 1
done

if ! waydroid status 2>/dev/null | grep -q 'Session:[[:space:]]*RUNNING'; then
    log "Waydroid session did not become ready"
    waydroid status 2>/dev/null || true
    tail -n 100 /tmp/waydroid-session.log 2>/dev/null || true
    exit 1
fi

if [ -z "$ADB_BIND" ]; then
    ADB_BIND=$(ip -4 route get 1.1.1.1 2>/dev/null |
        awk '{
            for (i = 1; i <= NF; i++) {
                if ($i == "src") {
                    print $(i + 1)
                    exit
                }
            }
        }')
fi

if [ -z "$ANDROID_IP" ]; then
    log "waiting for the Waydroid IPv4 address"
    attempt=0
    while [ "$attempt" -lt 60 ]; do
        ANDROID_IP=$(run_root waydroid shell ip -4 addr show dev eth0 2>/dev/null |
            sed -n 's/^[[:space:]]*inet[[:space:]]\+\([0-9.]*\)\/.*/\1/p' |
            head -n 1)

        [ -n "$ANDROID_IP" ] && break

        attempt=$((attempt + 1))
        sleep 1
    done
fi

if [ -z "$ADB_BIND" ]; then
    log "failed to detect the host IPv4 address; set ADB_BIND explicitly"
    exit 1
fi

if [ -z "$ANDROID_IP" ]; then
    log "failed to detect the Waydroid IPv4 address"
    exit 1
fi

log "starting ADB forwarding: $ADB_BIND:$ADB_PORT -> $ANDROID_IP:$ADB_PORT"
socat \
    "TCP-LISTEN:${ADB_PORT},bind=${ADB_BIND},reuseaddr,fork" \
    "TCP:${ANDROID_IP}:${ADB_PORT}" \
    > /tmp/waydroid-socat.log 2>&1 &
SOCAT_PID=$!

sleep 1
if ! is_running "$SOCAT_PID"; then
    log "socat terminated during startup"
    cat /tmp/waydroid-socat.log 2>/dev/null || true
    exit 1
fi

waydroid show-full-ui > /tmp/waydroid-ui.log 2>&1 &
UI_PID=$!

log "starting VNC on $VNC_BIND:$VNC_PORT, output=$output_name, max-fps=$VNC_FPS"
wayvnc \
    --output="$output_name" \
    --max-fps="$VNC_FPS" \
    "$VNC_BIND" \
    "$VNC_PORT" \
    > /tmp/wayvnc.log 2>&1 &
WAYVNC_PID=$!

sleep 1
if ! is_running "$WAYVNC_PID"; then
    log "wayvnc terminated during startup"
    cat /tmp/wayvnc.log 2>/dev/null || true
    exit 1
fi

log "ready: vnc://$VNC_BIND:$VNC_PORT"
log "ready: adb connect $ADB_BIND:$ADB_PORT"
log "press Ctrl-C to stop everything started by this script"

while is_running "$SWAY_PID" && \
      is_running "$WAYVNC_PID" && \
      is_running "$SOCAT_PID" && \
      is_running "$SESSION_PID"; do
    if container_is_running; then
        CONTAINER_FAILURES=0
    else
        CONTAINER_FAILURES=$((CONTAINER_FAILURES + 1))
        log "Waydroid container is not running ($CONTAINER_FAILURES/$CONTAINER_FAILURE_LIMIT)"

        if [ "$CONTAINER_FAILURES" -ge "$CONTAINER_FAILURE_LIMIT" ]; then
            log "Waydroid container remained stopped; requesting service restart"
            exit 1
        fi
    fi

    sleep 2
done

log "a required process exited"
[ -f /tmp/sway-waydroid.log ] && tail -n 30 /tmp/sway-waydroid.log
[ -f /tmp/wayvnc.log ] && tail -n 30 /tmp/wayvnc.log
[ -f /tmp/waydroid-socat.log ] && tail -n 30 /tmp/waydroid-socat.log
[ -f /tmp/waydroid-session.log ] && tail -n 30 /tmp/waydroid-session.log
exit 1
