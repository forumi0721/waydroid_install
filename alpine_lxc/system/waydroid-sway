#!/sbin/openrc-run

name="Waydroid Sway session"
description="Waydroid session with Sway, PulseAudio and WayVNC"

command="/usr/local/bin/waydroid-sway-session"
command_user="forumi0721:users"

supervisor="supervise-daemon"
pidfile="/run/${RC_SVCNAME}.pid"

output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.err"

retry="TERM/30/KILL/5"

# 비정상 종료 후 5초 뒤 재시작
respawn_delay=5

# 재시작 횟수 무제한
respawn_max=0

export HOME="/home/forumi0721"
export USER="forumi0721"
export LOGNAME="forumi0721"

depend()
{
    need localmount
    after networking
}

start_pre()
{
    checkpath \
        --directory \
        --owner forumi0721:users \
        --mode 0700 \
        /run/user/1000

    checkpath \
        --file \
        --owner forumi0721:users \
        --mode 0644 \
        "$output_log"

    checkpath \
        --file \
        --owner forumi0721:users \
        --mode 0644 \
        "$error_log"
}
